# AGROGUIDCI — variables d'environnement attendues (valeurs vides : à remplir hors dépôt).
# Copier en .env.local (poste) ou déclarer dans Vercel (Production / Preview).

# --- relais Vercel -> moteur ------------------------------------------------
# URL du moteur dédié (HTTPS obligatoire hors développement local).
# Vide = le relais refuse de démarrer plutôt que d'envoyer la clé ailleurs.
AGRO_ENGINE_URL=
# Clé d'API du moteur (X-API-Key). Ne jamais préfixer par NEXT_PUBLIC_/VITE_/PUBLIC_.
AGRO_ENGINE_KEY=
# Hôtes autorisés pour AGRO_ENGINE_URL, séparés par des virgules (facultatif, recommandé).
AGRO_ENGINE_HOSTS=
# 1 (défaut) = aucune cible par défaut ; 0 = repli sur le moteur historique.
AGRO_RELAIS_STRICT=1

# --- moteur Python ----------------------------------------------------------
AGRO_API_KEY=
AGRO_CORS_ORIGINS=
AGRO_ENV=
AGRO_ORCH=http://127.0.0.1:8000
AGRO_LLM_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
AGRO_LLM_MODEL=

# --- garde-fous des requêtes sortantes --------------------------------------
# 1 (défaut) = liste blanche active ; 0 = désactivée (dépannage uniquement).
AGRO_HTTP_GARDE=1
AGRO_HTTP_DOMAINES_PUBLICS=
AGRO_HTTP_MAX_OCTETS=
AGRO_HTTP_DELAI_MAX=

# --- serveur de démonstration local (api.py) --------------------------------
AGRO_CORS_PERMISSIF=
AGRO_DEMO_HOST=127.0.0.1
AGRO_DEMO_PORT=8080
