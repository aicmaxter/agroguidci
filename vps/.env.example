# AGROGUIDCI — moteur sur VPS (copier en .env : cp .env.example .env)
# Le fichier .env contient des secrets : il ne doit jamais être commité.

# Domaine public du moteur (enregistrement A vers l'IP du VPS, avant le 1er démarrage).
# Exemple : api.agroguidci.org
AGRO_DOMAINE=

# Clé d'API du moteur : à générer (openssl rand -hex 32). La même valeur est stockée
# dans les variables Vercel du projet « agroguidci-site » (AGRO_ENGINE_KEY).
AGRO_API_KEY=

# Clé administrateur de l'orchestrateur (openssl rand -hex 24). Sert à interroger la
# console d'administration et à lire la clé d'enrôlement des agents.
ORCH_ADMIN_KEY=

# Origines autorisées à appeler l'API depuis un navigateur.
AGRO_CORS_ORIGINS=https://agroguidci.vercel.app

# Modèle de langage (clé DeepSeek obligatoire : sans elle, les agents déclarent l'échec).
DEEPSEEK_API_KEY=
AGRO_LLM_MODEL=deepseek-chat

# Capacité du moteur : 2 missions simultanées au maximum (une mission = 5 à 7 appels
# de modèle). Monter à 3 seulement si le VPS a du CPU et du budget d'API à revendre.
AGRO_MAX_CONCURRENCE=2

# Durée maximale d'une mission avant interruption déclarée (secondes).
AGRO_BUDGET_S=300
