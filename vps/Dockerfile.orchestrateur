# Orchestrateur multi-agents (réseau local d'agents) — service interne du moteur.
# Contexte de build : la racine du dépôt ; le code de l'orchestrateur est copié dans
# vps/orchestrateur/ avant le build (voir DEPLOIEMENT-VPS.md).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    ORCH_HOST=0.0.0.0 \
    ORCH_PORT=8000 \
    ORCH_LEASE=900 \
    ORCH_DELEGATE_TIMEOUT=420

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

COPY vps/orchestrateur/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY vps/orchestrateur/ .

RUN mkdir -p data logs
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=6 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["python", "-u", "orchestrateur.py"]
